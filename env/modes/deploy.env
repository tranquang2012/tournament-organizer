# Applied when you run: npm run env:deploy
# Replace YOUR_EC2_PUBLIC_IP before first deploy, or keep your existing FRONTEND_URL (script preserves it).

@file backend/.env
PORT=5000
FRONTEND_URL=http://YOUR_EC2_PUBLIC_IP

@file .env
FRONTEND_URL=http://YOUR_EC2_PUBLIC_IP

@file frontend/.env
# No BACKEND_PORT — Vite dev is not used in deploy mode.
