# Docker Compose environment (deploy mode).
# Switch modes: npm run env:deploy  |  npm run env:local  |  npm run env:status
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=false
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_ANON_KEY="YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY"

VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY"
# Optional — leave unset when using Docker (nginx proxies /api to backend).
# VITE_API_BASE_URL="http://localhost:5000"

# Email reminders (backend). Set FRONTEND_URL to your public site URL on EC2, e.g. http://<EC2_IP>/
EMAIL_REMINDERS_ENABLED=false
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Tournament Organizer <no-reply@example.com>"
FRONTEND_URL="http://localhost"
REMINDER_DAYS_BEFORE=1
REMINDER_TIME_ZONE="Asia/Ho_Chi_Minh"
EMAIL_REMINDER_INTERVAL_MS=900000
EMAIL_REMINDER_BATCH_SIZE=100
REMINDER_CLAIM_STALE_MINUTES=30