# Docker Compose environment.
PORT=5001
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=false
SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_ANON_KEY="YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY"

# Email reminders for favorited tournaments. SMTP_PORT=465 normally uses SMTP_SECURE=true;
# port 587 normally uses false. For Gmail, use an app password rather than your account password.
EMAIL_REMINDERS_ENABLED=false
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Tournament Organizer <no-reply@example.com>"
FRONTEND_URL="http://localhost:5173"
REMINDER_DAYS_BEFORE=1
REMINDER_TIME_ZONE="Asia/Ho_Chi_Minh"
EMAIL_REMINDER_INTERVAL_MS=900000
EMAIL_REMINDER_BATCH_SIZE=100
REMINDER_CLAIM_STALE_MINUTES=30

# Testing tournament IDs for different formats
TEST_TOUR_ID_SINGLE_ELIM="uuid-here"
TEST_TOUR_ID_DOUBLE_ELIM="uuid-here"
TEST_TOUR_ID_ROUND_ROBIN="uuid-here"
TEST_TOUR_ID_ROUND_SCORING="uuid-here"
TEST_TOUR_ID_HYBRID="uuid-here"
