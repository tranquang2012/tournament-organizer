# Local npm dev (env:local). Deploy/Docker uses PORT=5000 via env:deploy.
PORT=5001
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=false
SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_ANON_KEY="YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY"

# Email reminders for favorited tournaments. SMTP_PORT=465 normally uses SMTP_SECURE=true;
# port 587 normally uses false. For Gmail, use an app password rather than your account password.
EMAIL_REMINDERS_ENABLED=false
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Tournament Organizer <no-reply@example.com>"
FRONTEND_URL="http://localhost:5173"
REMINDER_DAYS_BEFORE=1
REMINDER_TIME_ZONE="Asia/Ho_Chi_Minh"
EMAIL_REMINDER_INTERVAL_MS=900000
EMAIL_REMINDER_BATCH_SIZE=100
REMINDER_CLAIM_STALE_MINUTES=30

# Admin tournament advisor (modelapi.vn Responses API). Do not commit real keys.
AI_BASE_URL=https://modelapi.vn/v1
AI_API_KEY=
AI_MODEL=gpt-5.6-sol
AI_REASONING_EFFORT=none
AI_MAX_OUTPUT_TOKENS=800
AI_MAX_INPUT_CHARS=12000
AI_TIMEOUT_MS=90000
